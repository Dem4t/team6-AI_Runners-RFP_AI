models:
  - type: main
    engine: openai
    parameters:
      model: "/home/ubuntu/models/lift"
      base_url: "http://localhost:8000/v1"
      temperature: 0.0

rails:
  input:
    flows:
      - self check input
      - block jailbreak
      - block off topic
  output:
    flows:
      - self check output